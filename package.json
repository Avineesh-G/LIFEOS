{
  "name": "lifeos",
  "private": true,
  "version": "1.2.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "generate:widget-colors": "node --experimental-strip-types scripts/generate-widget-colors.js",
    "check:palette": "node --experimental-strip-types scripts/check-palette.ts",
    "cap:sync": "npm run generate:widget-colors && npm run build && npx cap sync android",
    "cap:build": "npm run cap:sync && cd android && gradlew assembleRelease",
    "cap:open": "npx cap open android",
    "release:prep": "node scripts/prepare-release.js",
    "release:guard": "node --experimental-strip-types scripts/verify-release-guard.ts",
    "test:updater": "node --experimental-strip-types scripts/test-updater.ts",
    "test:backup": "node --experimental-strip-types scripts/test-backup-roundtrip.ts",
    "test:plugins": "node --experimental-strip-types scripts/test-plugin-compatibility.ts",
    "test:matrix": "node --experimental-strip-types scripts/test-layout-matrix.ts",
    "test:scroll": "node --experimental-strip-types scripts/test-scroll-regression.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capgo/capacitor-native-biometric": "^8.6.8",
    "@codetrix-studio/capacitor-google-auth": "^3.4.0-rc.4",
    "@fontsource-variable/google-sans-flex": "^5.3.1",
    "@google/generative-ai": "^0.24.1",
    "@material/material-color-utilities": "^0.3.0",
    "@rive-app/react-canvas-lite": "^4.34.3",
    "date-fns": "^3.6.0",
    "firebase": "^12.18.0",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.436.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.3",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0"
  }
}
