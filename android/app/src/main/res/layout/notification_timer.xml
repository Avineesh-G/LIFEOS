<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="3dp"
    android:paddingBottom="4dp">

    <!-- Title Row: Session Name -->
    <TextView
        android:id="@+id/notif_session_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Timer Row: Focus Time: 00:13:04  ● Active -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="3dp">

        <TextView
            android:id="@+id/notif_timer_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Focus Time: "
            android:textSize="13sp"
            android:textColor="?android:attr/textColorSecondary" />

        <Chronometer
            android:id="@+id/notif_chronometer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary" />

        <TextView
            android:id="@+id/notif_static_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:textColor="?android:attr/textColorPrimary" />

        <TextView
            android:id="@+id/notif_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#10B981"
            android:text="● Active" />
    </LinearLayout>

</LinearLayout>
