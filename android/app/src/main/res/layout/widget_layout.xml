<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Card Background (tinted dynamically according to day-phase) -->
    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_card"
        android:contentDescription="@null" />

    <!-- Main Content Container -->
    <LinearLayout
        android:id="@+id/widget_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical">

        <!-- 1. HERO TILE: Current Streak (Click -> lifeos://progress) -->
        <LinearLayout
            android:id="@+id/widget_tile_streak"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.0"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="2dp">

                <ImageView
                    android:id="@+id/widget_streak_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_widget_flame"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/widget_streak_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STREAK"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_streak_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="36sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:layout_marginTop="-2dp"
                android:layout_marginBottom="-2dp" />

            <TextView
                android:id="@+id/widget_streak_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DAYS ACTIVE"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />
        </LinearLayout>

        <!-- Vertical Subtle Divider -->
        <View
            android:id="@+id/widget_divider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="10dp"
            android:alpha="0.25" />

        <!-- RIGHT STATS COLUMN -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.25"
            android:orientation="vertical">

            <!-- 2. TASKS DONE TODAY (Click -> lifeos://tasks) -->
            <LinearLayout
                android:id="@+id/widget_tile_tasks"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.0"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/widget_tasks_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_widget_check"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/widget_tasks_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0/0"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/widget_tasks_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TASKS TODAY"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.04" />
                </LinearLayout>
            </LinearLayout>

            <!-- 3. STUDY TIME TODAY (Click -> lifeos://study) -->
            <LinearLayout
                android:id="@+id/widget_tile_study"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.0"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/widget_study_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_widget_clock"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/widget_study_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0m"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/widget_study_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="STUDY TIME"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.04" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
